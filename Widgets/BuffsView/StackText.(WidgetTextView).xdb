<?xml version="1.0" encoding="UTF-8" ?>
<WidgetTextView>
	<Name>StackText</Name>
	<Priority>5050</Priority>
	<Placement>
		<X>
			<Align>WIDGET_ALIGN_HIGH</Align>
			<Size>50</Size>
			<HighPos>2</HighPos>
		</X>
		<Y>
			<Align>WIDGET_ALIGN_HIGH</Align>
			<Sizing>WIDGET_SIZING_INTERNAL</Sizing>
			<Size>25</Size>
			<HighPos>2</HighPos>
		</Y>
	</Placement>
	<TransparentInput>true</TransparentInput>
	<FormatFileRef href="Text.txt" />
</WidgetTextView>
